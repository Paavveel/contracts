{
	"name": "@paavveel/contracts",
	"version": "1.0.2",
	"description": "Protobuf definitions and generated TS types",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"generate": "protoc -I ./proto ./proto/*.proto --ts_proto_out=./gen --ts_proto_opt=nestJs=true,package=omit"
	},
	"files": [
		"dist",
		"proto",
		"gen"
	],
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@nestjs/microservices": "^11.1.27",
		"rxjs": "^7.8.2",
		"ts-proto": "^2.11.8"
	},
	"devDependencies": {
		"@paavveel/core": "^1.0.3",
		"@types/node": "^26.1.1",
		"prettier": "^3.9.5",
		"typescript": "^7.0.2"
	}
}
